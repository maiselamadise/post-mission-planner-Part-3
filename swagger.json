            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Spiritual goal deleted"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid id format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "description": "Requires login."
      }
    },
    "/auth/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in with GitHub (open in the browser, not Try it out)",
        "responses": {
          "302": {
            "description": "Redirects to GitHub"
          },
          "503": {
            "description": "OAuth not configured"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out and destroy the session",
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Show the logged-in user",
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    }
